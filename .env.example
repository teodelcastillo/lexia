# ================================================================
# Lexia — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Nota: solo NEXT_PUBLIC_* son accesibles en el navegador.
# ================================================================

# ---- Supabase (OBLIGATORIO) -----------------------------------
# Valores que se encuentran en https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key (server-only, usado por crons y admin). NO publicar.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL publica del sitio (utilizada para enlaces en emails, password reset, etc.)
# En produccion: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- IA (OBLIGATORIO para Lexia) ------------------------------
# El resolver usa los providers oficiales (@ai-sdk/openai, @ai-sdk/anthropic)
# que leen estas variables automaticamente.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ---- Cron jobs (Vercel) ---------------------------------------
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ---- Creditos Lexia (opcional) --------------------------------
# 'true' para aplicar limites de creditos, 'false'/unset para desactivarlo
LEXIA_CREDITS_ENFORCEMENT=false

# ---- Feature flags (desarrollo) -------------------------------
# Solo se permiten fuera de produccion
SEED_USERS_ENABLED=false
VIEW_AS_ENABLED=false

# ---- Integracion Google (OPCIONAL: Calendar/Drive/Docs) -------
# Ver docs/04-integracion-google.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ---- Modulo SAC (Cordoba) - OPCIONAL --------------------------
# Clave hex de 32 bytes (64 hex chars) para cifrar credenciales SAC
# Generar con: openssl rand -hex 32
SAC_ENCRYPTION_KEY=
# Opcional: override de la URL base
# SAC_BASE_URL=https://www.justiciacordoba.gob.ar/justiciacordoba/extranet.aspx
